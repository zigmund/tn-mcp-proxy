[Unit]
Description=tn-mcp-proxy (OAuth 2.1 facade for the Tradernet MCP)
Documentation=https://github.com/zigmund/tn-mcp-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/tn-mcp-proxy -config /etc/tn-mcp-proxy/config.yaml
# SIGHUP is handled by the binary and does not stop it (reloads the TLS certificate when tls.* is set).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# SIGTERM starts a graceful shutdown: the binary waits up to 15 s for in-flight
# requests, then closes the remaining connections (long-lived SSE streams never
# end on their own). 30 s leaves headroom before systemd sends SIGKILL.
TimeoutStopSec=30s

# Run as a transient unprivileged user; no state is written to disk.
DynamicUser=yes

# Token encryption keys. The config should NOT contain `token_keys`: with
# DynamicUser= the config file is typically root-owned and world-readable (see
# the README). Instead keep the keys in a
# root-only file and let systemd hand a private copy to the service:
#   secrets.token_keys_file: /run/credentials/tn-mcp-proxy.service/keys
# (the config does not expand environment variables, so $CREDENTIALS_DIRECTORY
# cannot be used there; use the absolute path above, the name after the colon
# below is the file name inside the credentials directory).
# Create the source file with: install -m 0600 -o root -g root /dev/null /etc/tn-mcp-proxy/keys
LoadCredential=keys:/etc/tn-mcp-proxy/keys

# Built-in TLS (tls.cert_file/tls.key_file), pick one:
# a) Hot reload from Let's Encrypt: grant read access to the cert files via a
#    group that can read /etc/letsencrypt/{live,archive}, e.g.
#      SupplementaryGroups=tls-certs
#    /etc/letsencrypt/{live,archive} are 0700 root and privkey*.pem 0600 by
#    default: groupadd tls-certs; chgrp -R tls-certs the two dirs; chmod 750
#    them; chmod 640 archive/*/privkey*.pem (see docs/configuration.md; re-apply
#    from a certbot deploy hook, then `systemctl reload tn-mcp-proxy`).
# b) Private copy (no hot reload; needs a restart after renewal):
#      LoadCredential=fullchain.pem:/etc/letsencrypt/live/mcp.example.com/fullchain.pem
#      LoadCredential=privkey.pem:/etc/letsencrypt/live/mcp.example.com/privkey.pem
#    with tls.cert_file/key_file under /run/credentials/tn-mcp-proxy.service/.
# Binding a port below 1024 additionally needs AmbientCapabilities=CAP_NET_BIND_SERVICE
# (and CapabilityBoundingSet=CAP_NET_BIND_SERVICE); prefer a high port.

# --- Hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Outbound HTTPS to the upstream and inbound TCP only. Add AF_UNIX only if you
# need syslog/journald sockets from inside the process (stderr is enough here).
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Go binaries do not need W+X mappings.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
